{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentcloud.dev/contracts/novel-release-1.0.schema.json",
  "title": "ContentCloud Novel Release 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "series_id", "chapter_id", "chapter_no", "approved_snapshot_id", "canon_version", "canon_digest", "chapter_digest", "channel_profile_ref", "files", "external_actions", "checks", "status", "created_at"],
  "properties": {
    "schema_version": {"const": "contentcloud.novel-release/1.0"},
    "id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "series_id": {"type": "string", "minLength": 1},
    "chapter_id": {"type": "string", "minLength": 1},
    "chapter_no": {"type": "integer", "minimum": 1},
    "approved_snapshot_id": {"type": "string", "minLength": 1},
    "canon_version": {"type": "integer", "minimum": 1},
    "canon_digest": {"$ref": "#/$defs/digest"},
    "chapter_digest": {"$ref": "#/$defs/digest"},
    "channel_profile_ref": {"type": "string", "pattern": "^channel:[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "files": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["format", "path", "media_type", "sha256", "byte_size"], "properties": {"format": {"enum": ["chapter_json", "chapter_text", "canon_json"]}, "path": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}, "byte_size": {"type": "integer", "minimum": 1}}}},
    "external_actions": {"type": "array", "items": {"enum": ["manual_login", "manual_preview", "manual_publish", "record_external_binding"]}, "uniqueItems": true},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": {"name": {"type": "string", "minLength": 1}, "status": {"const": "passed"}}}},
    "status": {"const": "validated"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
