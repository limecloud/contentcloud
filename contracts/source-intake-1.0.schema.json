{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentcloud.dev/contracts/source-intake-1.0.schema.json",
  "title": "ContentCloud Source Intake Receipt 1.0",
  "oneOf": [
    { "$ref": "#/$defs/searchReceipt" },
    { "$ref": "#/$defs/fetchReceipt" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "searchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "snippet", "rank"],
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "snippet": { "type": "string" },
        "rank": { "type": "integer", "minimum": 1 },
        "published_at": { "type": "string", "format": "date-time" }
      }
    },
    "searchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "project_id", "query", "results", "provider", "search_key"],
      "properties": {
        "schema_version": { "const": "contentcloud.source-intake/1.0" },
        "kind": { "const": "search_receipt" },
        "project_id": { "type": "string", "minLength": 1 },
        "query": { "type": "string", "minLength": 2, "maxLength": 500 },
        "results": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/searchResult" } },
        "provider": { "type": "string", "minLength": 1 },
        "search_key": { "$ref": "#/$defs/digest" }
      }
    },
    "fetchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "project_id", "requested_url", "final_url", "digest", "mime", "revision", "reused"],
      "properties": {
        "schema_version": { "const": "contentcloud.source-intake/1.0" },
        "kind": { "const": "fetch_receipt" },
        "project_id": { "type": "string", "minLength": 1 },
        "requested_url": { "type": "string", "format": "uri" },
        "final_url": { "type": "string", "format": "uri" },
        "digest": { "$ref": "#/$defs/digest" },
        "mime": { "enum": ["text/plain", "text/html", "application/json"] },
        "revision": { "type": "object" },
        "reused": { "type": "boolean" }
      }
    }
  }
}
