{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentcloud.local/contracts/douyin-commerce-validation-1.0.schema.json",
  "title": "ContentCloud DouyinCommerceValidationReceipt 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_profile_id",
    "project_id",
    "audience_strategy_approved_snapshot_id",
    "audience_strategy_version_id",
    "offer_approved_snapshot_id",
    "offer_snapshot_id",
    "content_approved_snapshot_id",
    "content_item_id",
    "content_item_digest",
    "storyboard_approved_snapshot_id",
    "storyboard_package_id",
    "storyboard_locked_digest",
    "rendered_creative_artifact_id",
    "rendered_creative_digest",
    "voiceover_text_digest",
    "on_screen_text_digest",
    "landing_page_text_digest",
    "offer",
    "observed_benefits",
    "observed_conditions",
    "account_ref",
    "product_anchor_ref",
    "landing_page_ref",
    "scheduled_at",
    "validated_at",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "contentcloud.douyin-commerce-validation/1.0"},
    "content_profile_id": {"const": "douyin-commerce-video"},
    "project_id": {"type": "string", "minLength": 1},
    "audience_strategy_approved_snapshot_id": {"type": "string", "minLength": 1},
    "audience_strategy_version_id": {"type": "string", "minLength": 1},
    "offer_approved_snapshot_id": {"type": "string", "minLength": 1},
    "offer_snapshot_id": {"type": "string", "minLength": 1},
    "content_approved_snapshot_id": {"type": "string", "minLength": 1},
    "content_item_id": {"type": "string", "minLength": 1},
    "content_item_digest": {"$ref": "#/$defs/digest"},
    "storyboard_approved_snapshot_id": {"type": "string", "minLength": 1},
    "storyboard_package_id": {"type": "string", "minLength": 1},
    "storyboard_locked_digest": {"$ref": "#/$defs/digest"},
    "rendered_creative_artifact_id": {"type": "string", "minLength": 1},
    "rendered_creative_digest": {"$ref": "#/$defs/digest"},
    "voiceover_text_digest": {"$ref": "#/$defs/digest"},
    "on_screen_text_digest": {"$ref": "#/$defs/digest"},
    "landing_page_text_digest": {"$ref": "#/$defs/digest"},
    "offer": {"$ref": "#/$defs/offerFacts"},
    "observed_benefits": {"$ref": "#/$defs/uniqueStrings"},
    "observed_conditions": {"$ref": "#/$defs/uniqueStrings"},
    "account_ref": {"type": "string", "minLength": 1},
    "product_anchor_ref": {"type": "string", "minLength": 1},
    "landing_page_ref": {"type": "string", "minLength": 1},
    "scheduled_at": {"type": "string", "format": "date-time"},
    "validated_at": {"type": "string", "format": "date-time"},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uniqueStrings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "offerFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku_id", "product_version_id", "display_price", "currency", "benefits", "conditions"],
      "properties": {
        "sku_id": {"type": "string", "minLength": 1},
        "product_version_id": {"type": "string", "minLength": 1},
        "display_price": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "benefits": {"$ref": "#/$defs/uniqueStrings"},
        "conditions": {"$ref": "#/$defs/uniqueStrings"}
      }
    }
  }
}
