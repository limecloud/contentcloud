{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentcloud.goodvision.cn/schemas/video-script-1.0.schema.json",
  "title": "ContentCloud Video Script 1.0 Compatibility Payload",
  "type": "object",
  "anyOf": [
    {"required": ["title"]},
    {"required": ["name"]}
  ],
  "required": ["schema_version"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"const": "video_script"},
    "schema_version": {"const": "contentcloud.video_script/1.0"},
    "status": {"enum": ["candidate", "approved", "blocked"]},
    "deliverability": {"enum": ["blocked", "review_ready"]},
    "project_id": {"type": "string", "minLength": 1},
    "content_id": {"type": "string", "minLength": 1},
    "content_batch_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "scenes": {"type": "array", "minItems": 1},
    "items": {"type": "array", "minItems": 1},
    "knowledge_snapshot_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_summary": {"type": "object"},
    "rights_summary": {"type": "object"}
  },
  "additionalProperties": true
}
