{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentcloud.dev/contracts/agent-execution-1.0.schema.json",
  "title": "ContentCloud Remote Agent Execution 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "job_run_id", "node_run_id", "attempt_id", "context_digest", "prompt", "output_schema", "session_options"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1 },
    "job_run_id": { "type": "string", "minLength": 1 },
    "node_run_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "context_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "prompt": { "type": "string", "minLength": 1 },
    "continuation_prompt": { "type": "string" },
    "output_schema": { "type": "object" },
    "session_options": { "type": "object" }
  }
}
