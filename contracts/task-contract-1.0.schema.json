{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentcloud.goodvision.cn/schemas/task-contract-1.0.schema.json",
  "title": "ContentCloud Task Contract 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "contract_id", "run_id", "task_type", "project", "sources", "input_snapshot_id", "output_schema", "required_capability", "manifest_hash"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "contract_id": {"type": "string"},
    "run_id": {"type": "string"},
    "task_type": {"const": "knowledge_extract"},
    "project": {"type": "object"},
    "sources": {"type": "array", "items": {"type": "object"}},
    "input_snapshot_id": {"type": "string"},
    "output_schema": {"const": "knowledge-candidates/1.0"},
    "required_capability": {"type": "object"},
    "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
