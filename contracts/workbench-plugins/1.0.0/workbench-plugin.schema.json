{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentcloud.run/schemas/workbench-plugin/1.0.0/workbench-plugin.schema.json",
  "title": "ContentCloud Business Workbench Plugin",
  "description": "Declarative customer workbench contract. It references an approved ExperienceTemplate and renders only through platform-approved primitives.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "https://contentcloud.run/schemas/workbench-plugin/1.0.0/workbench-plugin.schema.json"},
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "content_types": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"template_id": {"type": "string", "minLength": 1}},
      "required": ["template_id"]
    },
    "ui": {"$ref": "#/$defs/ui"}
  },
  "required": ["$schema", "id", "version", "name", "content_types", "experience", "ui"],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "renderer": {"const": "approved"},
        "layout": {"enum": ["stage-canvas-context", "article-editor", "product-variants", "novel-editor"]},
        "density": {"enum": ["compact", "comfortable", "dense"]},
        "theme": {"enum": ["signal-blue", "editorial-green", "production-coral", "review-rose"]},
        "navigation": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/navigationItem"}},
        "stages": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/stage"}},
        "panels": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/panel"}}
      },
      "required": ["renderer", "layout", "density", "theme", "navigation", "stages"]
    },
    "navigationItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/identifier"}, "label": {"type": "string", "minLength": 1}, "icon": {"$ref": "#/$defs/icon"}},
      "required": ["id", "label", "icon"]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/identifier"}, "label": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}, "primary_action": {"$ref": "#/$defs/action"}},
      "required": ["id", "label", "outcome", "primary_action"]
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "tone": {"enum": ["source", "knowledge", "strategy", "production", "review"]},
        "icon": {"$ref": "#/$defs/icon"},
        "stage_ids": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/identifier"}},
        "target": {"enum": ["start", "tasks", "assets", "deliveries"]},
        "action_label": {"type": "string", "minLength": 1}
      },
      "required": ["id", "title", "detail", "tone", "icon", "stage_ids", "target", "action_label"]
    },
    "action": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?!.*(?:__|\\.\\.))[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "icon": {"enum": ["archive", "book-open", "file-check", "file-text", "folder", "image", "lightbulb", "list-checks", "package-check", "pen-line", "scroll-text", "shopping-bag", "tags", "video"]}
  }
}
