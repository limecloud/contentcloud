{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentcloud.dev/contracts/model-generation-1.0.schema.json",
  "title": "ContentCloud Model Generation Receipt 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tenant_id", "project_id", "task_id", "task_revision_id", "provider_id", "provider", "model", "request_digest", "response_digest", "input_tokens", "output_tokens", "total_tokens", "created_by", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_revision_id": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string" },
    "request_digest": { "$ref": "#/$defs/digest" },
    "response_digest": { "$ref": "#/$defs/digest" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
