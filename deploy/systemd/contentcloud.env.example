CONTENTCLOUD_DATABASE_URL=postgres://contentcloud:change_me@127.0.0.1:5432/contentcloud?sslmode=disable
CONTENTCLOUD_DATA_DIR=/var/lib/contentcloud
CONTENTCLOUD_ADDR=127.0.0.1:18082
CONTENTCLOUD_WEB_DIST=/opt/contentcloud/current/web
CONTENTCLOUD_DEV_MODE=0
CONTENTCLOUD_AUTO_MIGRATE=1
CONTENTCLOUD_PLATFORM_ADMIN_EMAILS=admin@example.com
CONTENTCLOUD_REQUIRE_MALWARE_SCAN=0

# Runtime rollout gates fail closed when omitted. Set CANARY_TENANT_IDS before
# enabling admission for the first tenant-scoped rollout. Disabling admission
# or dynamic graph does not stop reads, reaper, projections, reconciliation,
# or already running nodes.
CONTENTCLOUD_RUNTIME_ADMISSION_ENABLED=0
CONTENTCLOUD_RUNTIME_DYNAMIC_GRAPH_ENABLED=0
CONTENTCLOUD_RUNTIME_CANARY_TENANT_IDS=

# Enable these as one atomic set. Keep the binary signing key outside the release directory
# with mode 0400 or 0600; the server refuses partial configuration or repository-contained keys.
CONTENTCLOUD_ENVIRONMENT_PROFILE_FILE=/etc/contentcloud/environment-profile.json
CONTENTCLOUD_PLUGIN_REGISTRY_FILE=/etc/contentcloud/plugin-registry.json
CONTENTCLOUD_PLUGIN_TRUST_FILE=/etc/contentcloud/plugin-trusted-keys.json
CONTENTCLOUD_ENVIRONMENT_TRUST_FILE=/etc/contentcloud/environment-trusted-keys.json
CONTENTCLOUD_ENVIRONMENT_SIGNING_KEY_FILE=/etc/contentcloud/secrets/environment-ed25519.key
CONTENTCLOUD_ENVIRONMENT_SIGNING_KEY_ID=contentcloud-environment-2026-07
# comma-separated tenant:provider=secret entries; keep outside repository
CONTENTCLOUD_PROVIDER_CALLBACK_SECRETS=
CONTENTCLOUD_CHANNEL_CALLBACK_SECRETS=
# comma-separated tenant:harness=secret entries; independent from Provider and channel secrets
CONTENTCLOUD_AGENT_CALLBACK_SECRETS=

# Controlled search/fetch and remote Connector endpoints
CONTENTCLOUD_SEARCH_ENDPOINT=
CONTENTCLOUD_FETCH_ALLOWED_HOSTS=
CONTENTCLOUD_CONNECTOR_ENDPOINT=
CONTENTCLOUD_CONNECTOR_API_KEY=

# OpenAI-compatible model inference providers
CONTENTCLOUD_VLLM_ENDPOINT=
CONTENTCLOUD_VLLM_MODEL=
CONTENTCLOUD_VLLM_API_KEY=
CONTENTCLOUD_SGLANG_ENDPOINT=
CONTENTCLOUD_SGLANG_MODEL=
CONTENTCLOUD_SGLANG_API_KEY=

# Provider-neutral remote Agent Harnesses
CONTENTCLOUD_REMOTE_AGENT_ENDPOINT=
CONTENTCLOUD_REMOTE_AGENT_TOKEN=
CONTENTCLOUD_PI_AGENT_ENDPOINT=
CONTENTCLOUD_PI_AGENT_TOKEN=
CONTENTCLOUD_AGENT_SAAS_ENDPOINT=
CONTENTCLOUD_AGENT_SAAS_TOKEN=
CONTENTCLOUD_CAPABILITY_RELEASE_VERSION=0.26.0
CONTENTCLOUD_ENVIRONMENT_MANIFEST_TTL=24h
