      "input_schemas": [
        "contracts/brief-3.0.schema.json",
        "contracts/content-item-3.0.schema.json",
        "contracts/local-run-3.0.schema.json"
      ],
      "output_schemas": [
        "contracts/audience-strategy-1.0.schema.json",
        "contracts/content-batch-3.0.schema.json",
