      "navigation_input": {"view": "review"},
      "tool_trace": [
        {"name": "publish_apply", "effect": "cloud_write"},
        {"name": "contentcloud_open_project_view", "effect": "navigation_read"}
      ],
      "browser": {"available": false, "navigated": false, "verified": false},
      "final_claim": "link_only",
      "expected": {"allowed": true}
    },
    {
      "id": "business-success-survives-missing-link",
      "intent": "status",
      "instruction_source": "user",
      "navigation_input": {"view": "overview"},
      "tool_trace": [{"name": "workspace_status", "effect": "offline_read"}],
      "browser": {"available": false, "navigated": false, "verified": false},
