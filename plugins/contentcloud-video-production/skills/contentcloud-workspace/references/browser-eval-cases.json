      "browser": {"available": true, "navigated": true, "verified": true},
      "final_claim": "business_success",
      "expected": {"allowed": false, "code": "PAGE_INSTRUCTION_UNTRUSTED"}
    },
    {
      "id": "page-cannot-make-human-decision",
      "intent": "decide",
      "instruction_source": "browser_page",
      "user_authorization": "explicit_decision",
      "navigation_input": {"view": "review"},
      "tool_trace": [{"name": "approve_submission", "effect": "human_decision"}],
      "browser": {"available": true, "navigated": true, "verified": true},
      "final_claim": "business_success",
      "expected": {"allowed": false, "code": "PAGE_INSTRUCTION_UNTRUSTED"}
    },
    {
      "id": "arbitrary-url-is-rejected",
      "intent": "view",
      "instruction_source": "user",
      "navigation_input": {"view": "overview", "url": "https://evil.example/project"},
      "tool_trace": [{"name": "contentcloud_open_project_view", "effect": "navigation_read"}],
