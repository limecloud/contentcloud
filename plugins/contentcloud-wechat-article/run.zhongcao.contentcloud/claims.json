{
  "schema_version": "contentcloud.plugin-claims/1.0",
  "plugin_id": "contentcloud-wechat-article",
  "plugin_version": "0.1.0",
  "package_spec_version": "1.0.0",
  "kind": "skill_pack",
  "requested_capabilities": [
    {
      "id": "contentcloud.wechat-article",
      "version": "1.0.0",
      "input_schemas": [
        "contracts/article-brief-1.0.schema.json",
        "contracts/knowledge-pack-3.0.schema.json"
      ],
      "output_schemas": [
        "contracts/article-1.0.schema.json",
        "contracts/wechat-delivery-1.0.schema.json"
      ]
    }
  ],
  "permissions_requested": [
    "workspace:read",
    "workspace:write-managed",
    "contentcloud-control-plane:explicit-actions-only"
  ],
  "data_flow": {
    "local_by_default": true,
    "declared_cloud_actions": [
      "explicit publish and review synchronization"
    ]
  },
  "cost": {
    "model": "included",
    "notice": "ContentCloud article workflows are included; external image or model charges require separate confirmation."
  },
  "hosts": [
    {
      "id": "codex",
      "required": [
        "skills",
        "new_session_required"
      ]
    },
    {
      "id": "claude",
      "required": [
        "skills",
        "new_session_required"
      ]
    }
  ],
  "support": {
    "owner": "GoodVision ContentCloud",
    "runbook": "./run.zhongcao.contentcloud/RUNBOOK.md"
  }
}
